<script>
/* ====================================================================
   MatFinance — Frontend logic
   Local-first, optimistic UI, background sync queue.
   ==================================================================== */

// ---------------------- Constants ----------------------
const LS_TX = 'matfinance_transactions';
const LS_PENDING_ADD = 'matfinance_pending_add';
const LS_PENDING_DELETE = 'matfinance_pending_delete';
const LS_CATEGORIES = 'matfinance_categories';
const LS_LAST_SYNC = 'matfinance_last_sync';

const FALLBACK_CATEGORIES = {
  income: ['Salary', 'Freelance', 'Investment', 'Gift', 'Other Income'],
  expense: ['Food', 'Transport', 'Housing', 'Bills', 'Entertainment', 'Health', 'Education', 'Shopping', 'Other Expenses']
};

let state = {
  transactions: [],
  categories: FALLBACK_CATEGORIES,
  currentType: 'Expense',
  activeTab: 'add',
  chart: null,
  syncing: false
};

// ---------------------- Utilities ----------------------
function formatAmount(n) {
  const num = Math.round(Number(n) || 0);
  return num.toLocaleString('en-US');
}

function parseAmountInput(str) {
  return Number(String(str).replace(/[^0-9]/g, '')) || 0;
}

// Format input live as user types
document.getElementById('amountInput').addEventListener('input', function() {
  let raw = this.value.replace(/[^0-9]/g, '');
  if (raw === '') {
    this.value = '';
    return;
  }
  this.value = Number(raw).toLocaleString('en-US');
});

function uid() {
  return 'local-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
}
function saveLS(key, val) { localStorage.setItem(key, JSON.stringify(val)); }
function loadLS(key, fallback) {
  try {
    const raw = localStorage.getItem(key);
    return raw ? JSON.parse(raw) : fallback;
  } catch (e) { return fallback; }
}

// ---------------------- Jalali <-> Gregorian ----------------------
function gregorianToJalali(gy, gm, gd) {
  const g_d_m = [0,31,59,90,120,151,181,212,243,273,304,334];
  let jy = (gy <= 1600) ? 0 : 979;
  gy -= (gy <= 1600) ? 621 : 1600;
  const gy2 = (gm > 2) ? (gy + 1) : gy;
  let days = (365 * gy) + parseInt((gy2 + 3) / 4) - parseInt((gy2 + 99) / 100)
    + parseInt((gy2 + 399) / 400) - 80 + gd + g_d_m[gm - 1];
  jy += 33 * parseInt(days / 12053);
  days %= 12053;
  jy += 4 * parseInt(days / 1461);
  days %= 1461;
  if (days > 365) {
    jy += parseInt((days - 1) / 365);
    days = (days - 1) % 365;
  }
  const jm = (days < 186) ? 1 + parseInt(days / 31) : 7 + parseInt((days - 186) / 30);
  const jd = 1 + ((days < 186) ? (days % 31) : ((days - 186) % 30));
  return { jy: jy, jm: jm, jd: jd };
}
function jalaliDaysInMonth(jy, jm) {
  if (jm <= 6) return 31;
  if (jm <= 11) return 30;
  const isLeap = ((((jy - (jy > 0 ? 474 : 473)) % 2820) + 474 + 38) * 682) % 2816 < 682;
  return isLeap ? 30 : 29;
}
function pad2(n) { return String(n).padStart(2, '0'); }

// ---------------------- Init ----------------------
document.addEventListener('DOMContentLoaded', init);

function init() {
  state.transactions = loadLS(LS_TX, []);
  state.categories = loadLS(LS_CATEGORIES, FALLBACK_CATEGORIES);

  buildCategoryOptions();
  buildDatePickers();
  setTxType('Expense');
  renderAll();
  updateStatusPill('offline-cache');

  document.getElementById('txForm').addEventListener('submit', onSubmitTransaction);

  refreshFromServer();
  flushPendingQueue();

  window.addEventListener('online', flushPendingQueue);
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible') flushPendingQueue();
  });
  setInterval(flushPendingQueue, 30000);
}

// ---------------------- Tabs ----------------------
function switchTab(tab) {
  state.activeTab = tab;
  ['add', 'list', 'report'].forEach(t => {
    document.getElementById('tab-' + t).classList.toggle('hidden', t !== tab);
    document.getElementById('nav' + t.charAt(0).toUpperCase() + t.slice(1)).classList.toggle('tab-active', t === tab);
    document.getElementById('nav' + t.charAt(0).toUpperCase() + t.slice(1)).classList.toggle('text-slate-500', t !== tab);
  });
  if (tab === 'report') renderReport();
}

// ---------------------- Add form ----------------------
function setTxType(type) {
  state.currentType = type;
  const expBtn = document.getElementById('btnTypeExpense');
  const incBtn = document.getElementById('btnTypeIncome');
  if (type === 'Expense') {
    expBtn.className = 'flex-1 py-2 rounded-lg text-sm font-semibold transition bg-rose-500/20 text-rose-400';
    incBtn.className = 'flex-1 py-2 rounded-lg text-sm font-semibold transition text-slate-400';
  } else {
    incBtn.className = 'flex-1 py-2 rounded-lg text-sm font-semibold transition bg-emerald-500/20 text-emerald-400';
    expBtn.className = 'flex-1 py-2 rounded-lg text-sm font-semibold transition text-slate-400';
  }
  buildCategoryOptions();
}

function buildCategoryOptions() {
  const sel = document.getElementById('categorySelect');
  const list = state.currentType === 'Income' ? state.categories.income : state.categories.expense;
  sel.innerHTML = list.map(c => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
}

function buildDatePickers() {
  const today = new Date();
  const j = gregorianToJalali(today.getFullYear(), today.getMonth() + 1, today.getDate());

  const yearSel = document.getElementById('jYear');
  const monthSel = document.getElementById('jMonth');
  const daySel = document.getElementById('jDay');

  const years = [];
  for (let y = j.jy - 5; y <= j.jy + 1; y++) years.push(y);
  yearSel.innerHTML = years.map(y => `<option value="${y}" ${y === j.jy ? 'selected' : ''}>${y}</option>`).join('');

  const monthNames = ['Farvardin','Ordibehesht','Khordad','Tir','Mordad','Shahrivar','Mehr','Aban','Azar','Dey','Bahman','Esfand'];
  monthSel.innerHTML = monthNames.map((m, i) => `<option value="${i+1}" ${i+1===j.jm?'selected':''}>${m}</option>`).join('');

  function rebuildDays() {
    const jy = Number(yearSel.value), jm = Number(monthSel.value);
    const dim = jalaliDaysInMonth(jy, jm);
    const prevDay = Number(daySel.value) || j.jd;
    const days = [];
    for (let d = 1; d <= dim; d++) days.push(d);
    daySel.innerHTML = days.map(d => `<option value="${d}" ${d===Math.min(prevDay, dim)?'selected':''}>${d}</option>`).join('');
  }
  rebuildDays();
  daySel.value = j.jd;
  yearSel.addEventListener('change', rebuildDays);
  monthSel.addEventListener('change', rebuildDays);
}

function getSelectedJalaliDateString() {
  const jy = document.getElementById('jYear').value;
  const jm = pad2(document.getElementById('jMonth').value);
  const jd = pad2(document.getElementById('jDay').value);
  return `${jy}/${jm}/${jd}`;
}

function onSubmitTransaction(e) {
  e.preventDefault();
  const amount = parseAmountInput(document.getElementById('amountInput').value);
  const category = document.getElementById('categorySelect').value;
  const description = document.getElementById('descInput').value.trim();
  const date = getSelectedJalaliDateString();

  if (!amount || amount <= 0) {
    showToast('Please enter a valid amount.', 'error');
    return;
  }
  if (!category) {
    showToast('Please select a category.', 'error');
    return;
  }

  const tx = {
    id: uid(),
    date: date,
    type: state.currentType,
    category: category,
    description: description,
    amount: amount,
    _pending: true
  };

  state.transactions.unshift(tx);
  saveLS(LS_TX, state.transactions);
  renderAll();
  showToast('Transaction added ✓', 'success');

  document.getElementById('amountInput').value = '';
  document.getElementById('descInput').value = '';
  document.getElementById('amountInput').focus();

  const pending = loadLS(LS_PENDING_ADD, []);
  pending.push(tx);
  saveLS(LS_PENDING_ADD, pending);

  flushPendingQueue();
}

// ---------------------- Delete ----------------------
function requestDelete(id) {
  if (!confirm('Delete this transaction?')) return;

  state.transactions = state.transactions.filter(t => t.id !== id);
  saveLS(LS_TX, state.transactions);
  renderAll();

  let pendingAdd = loadLS(LS_PENDING_ADD, []);
  const wasUnsynced = pendingAdd.some(t => t.id === id);
  if (wasUnsynced) {
    pendingAdd = pendingAdd.filter(t => t.id !== id);
    saveLS(LS_PENDING_ADD, pendingAdd);
    showToast('Transaction deleted.', 'success');
    return;
  }

  const pendingDel = loadLS(LS_PENDING_DELETE, []);
  pendingDel.push(id);
  saveLS(LS_PENDING_DELETE, pendingDel);
  showToast('Transaction deleted.', 'success');
  flushPendingQueue();
}

// ---------------------- Sync engine ----------------------
function isGasAvailable() {
  return typeof google !== 'undefined' && google.script && google.script.run;
}

function refreshFromServer() {
  if (!isGasAvailable()) { updateStatusPill('offline'); return; }
  updateStatusPill('syncing');
  google.script.run
    .withSuccessHandler(function (res) {
      if (res && res.success) {
        state.categories = res.data.categories;
        saveLS(LS_CATEGORIES, state.categories);
        buildCategoryOptions();

        const pendingIds = new Set(loadLS(LS_PENDING_ADD, []).map(t => t.id));
        const serverTx = res.data.transactions.map(t => Object.assign({}, t, { _pending: false }));
        const stillPendingLocal = state.transactions.filter(t => pendingIds.has(t.id));
        state.transactions = stillPendingLocal.concat(serverTx)
          .sort((a, b) => (a.date < b.date ? 1 : -1));
        saveLS(LS_TX, state.transactions);
        saveLS(LS_LAST_SYNC, Date.now());
        renderAll();
        updateStatusPill('online');
      } else {
        updateStatusPill('error', res ? res.error : 'Unknown Error');
      }
    })
    .withFailureHandler(function (err) {
      updateStatusPill('offline');
      console.warn('refreshFromServer failed:', err);
    })
    .getInitialData();
}

function flushPendingQueue() {
  if (!isGasAvailable() || state.syncing) return;

  const pendingAdd = loadLS(LS_PENDING_ADD, []);
  const pendingDel = loadLS(LS_PENDING_DELETE, []);
  if (pendingAdd.length === 0 && pendingDel.length === 0) {
    updateStatusPill('online');
    return;
  }

  state.syncing = true;
  updateStatusPill('syncing');
  updatePendingBadge();

  const addQueue = pendingAdd.slice();
  const delQueue = pendingDel.slice();

  function processAdd(i) {
    if (i >= addQueue.length) { processDelete(0); return; }
    const tx = addQueue[i];
    google.script.run
      .withSuccessHandler(function (res) {
        let remaining = loadLS(LS_PENDING_ADD, []);
        if (res && res.success) {
          state.transactions = state.transactions.map(t =>
            t.id === tx.id ? Object.assign({}, t, { id: res.data.id, _pending: false }) : t
          );
          saveLS(LS_TX, state.transactions);
          remaining = remaining.filter(t => t.id !== tx.id);
          saveLS(LS_PENDING_ADD, remaining);
          renderAll();
        } else {
          console.warn('addTransaction sync failed, will retry:', res && res.error);
        }
        processAdd(i + 1);
      })
      .withFailureHandler(function (err) {
        console.warn('addTransaction network failure, will retry:', err);
        processAdd(addQueue.length);
      })
      .addTransaction(tx);
  }

  function processDelete(i) {
    if (i >= delQueue.length) { finishSync(); return; }
    const id = delQueue[i];
    google.script.run
      .withSuccessHandler(function (res) {
        let remaining = loadLS(LS_PENDING_DELETE, []);
        remaining = remaining.filter(x => x !== id);
        saveLS(LS_PENDING_DELETE, remaining);
        processDelete(i + 1);
      })
      .withFailureHandler(function (err) {
        console.warn('deleteTransaction network failure, will retry:', err);
        processDelete(delQueue.length);
      })
      .deleteTransaction(id);
  }

  function finishSync() {
    state.syncing = false;
    updatePendingBadge();
    const stillPending = loadLS(LS_PENDING_ADD, []).length + loadLS(LS_PENDING_DELETE, []).length;
    updateStatusPill(stillPending > 0 ? 'error' : 'online');
  }

  processAdd(0);
}

