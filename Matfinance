    badge.classList.add('hidden');
  }
}

function monthLabel(mm) {
  const names = ['Farvardin','Ordibehesht','Khordad','Tir','Mordad','Shahrivar','Mehr','Aban','Azar','Dey','Bahman','Esfand'];
  const idx = Number(mm) - 1;
  return names[idx] || mm;
}

function populateReportMonths() {
  const sel = document.getElementById('reportMonthSelect');
  const monthsPresent = Array.from(new Set(state.transactions.map(t => String(t.date).slice(5, 7)).filter(Boolean)));
  monthsPresent.sort();
  const today = new Date();
  const j = gregorianToJalali(today.getFullYear(), today.getMonth() + 1, today.getDate());
  const currentMonth = pad2(j.jm);
  if (!monthsPresent.includes(currentMonth)) monthsPresent.push(currentMonth);
  monthsPresent.sort();

  const prevValue = sel.value;
  sel.innerHTML = monthsPresent.map(m => `<option value="${m}">${monthLabel(m)} (Month ${m})</option>`).join('');
  sel.value = monthsPresent.includes(prevValue) ? prevValue : currentMonth;
  sel.onchange = renderReport;
