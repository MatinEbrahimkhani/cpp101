# =========================
# Operating System Files
# =========================

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory


# =========================
# VS Code
# =========================
# Most of .vscode/ is machine-specific, but tasks.json and
# launch.json are committed on purpose so a fresh clone can build
# and debug immediately (Ctrl+Shift+B / F5).

.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace


# =========================
# Build Directories
# =========================

build/
Build/
bin/
out/
output/
dist/
release/
debug/
Debug/
Release/


# =========================
# C/C++ Compiled Files
# =========================

# Object files
*.o
*.obj

# Executable files
*.exe
*.out
*.app
*.bin

# Dynamic libraries
*.dll
*.so
*.dylib

# Static libraries
*.lib
*.a

# Windows executable metadata
*.exp
*.ilk
*.pdb
*.idb

# Precompiled headers
*.gch
*.pch

# Compiled lesson binaries at the repo root (g++ -o produces no
# extension on Linux/macOS, so the patterns above alone won't catch
# these). Listed explicitly so it's obvious what's being ignored.
/00_Playground
/01_HelloWorld
/02_Variables
/03_InputOutput
/04_Conditionals
/05_Loops
/06_Functions
/07_Vectors
/08_Strings
/09_Structs
/10_FileIO
/11_SimpleAlgorithm
/12_DebuggingExample
/13_Capstone


