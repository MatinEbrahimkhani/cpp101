            sed 's/^/        /' "$VERIFY_DIR/${f%.cpp}.err"
            FAILED=1
        fi
    done
    rm -rf "$VERIFY_DIR"
    if [ "$FAILED" -ne 0 ]; then
        echo
        echo "WARNING: one or more lesson files failed to compile - see above."
        echo "Files were still written; please review before committing."
    else
        echo
        echo "All lessons compiled cleanly with -Wall -Wextra."
    fi
else
    echo "  g++ not found on PATH - skipping compile verification."
    echo "  (install a compiler and re-run 'g++ -Wall -Wextra <file>.cpp -o /tmp/test' per file to check)"
fi

echo
echo "--- Staging changes (git add -A) ---"
git add -A

