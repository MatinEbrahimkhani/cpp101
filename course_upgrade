#!/usr/bin/env bash
# ============================================================
# apply_course_upgrade.sh
# ------------------------------------------------------------
# Rewrites the cpp101 course in place: removes committed binaries
# and stray files, fixes the integer-division bug in Lesson 02,
# rewrites every lesson with explanations + exercises, adds a
# capstone project, a run.sh helper, working VS Code tasks, and a
# safer .gitignore.
#
# Run this from the ROOT of your cpp101 git clone:
#   cd ~/path/to/cpp101
#   bash apply_course_upgrade.sh
#
# Flags:
#   -y, --yes    skip the confirmation prompt
# ============================================================

set -euo pipefail

SKIP_CONFIRM=0
for arg in "$@"; do
    case "$arg" in
        -y|--yes) SKIP_CONFIRM=1 ;;
    esac
done

echo "============================================================"
echo " cpp101 course upgrade"
echo "============================================================"

# ------------------------------------------------------------
# Safety checks - make sure we're really in the cpp101 repo root
# ------------------------------------------------------------
if [ ! -d ".git" ]; then
    echo "ERROR: no .git directory here. Run this from the cpp101 repo root."
    exit 1
fi

if [ ! -f "TEACHER_NOTES.md" ] && [ ! -f "01_HelloWorld.cpp" ]; then
    echo "ERROR: this doesn't look like the cpp101 repo (expected"
    echo "       TEACHER_NOTES.md or 01_HelloWorld.cpp here). Aborting"
    echo "       to avoid touching the wrong folder."
    exit 1
fi

echo
echo "This will, in this repo:"
echo "  - remove committed compiled binaries (01_HelloWorld, 02_Variables)"
echo "  - remove main.cpp, Matfinance, plan-advancedHelloWorld.prompt.md"
echo "  - overwrite 01-12 lesson files with expanded versions"
echo "  - add 00_Playground.cpp and 13_Capstone.cpp"
echo "  - overwrite README.md, TEACHER_NOTES.md, .gitignore"
echo "  - add run.sh and .vscode/tasks.json + launch.json"
echo "  - create a backup git branch of the current state"
echo "  - stage everything with 'git add -A' (does NOT commit or push)"
echo

if [ "$SKIP_CONFIRM" -ne 1 ]; then
    read -r -p "Continue? [y/N] " REPLY
    case "$REPLY" in
        [yY]|[yY][eE][sS]) ;;
        *) echo "Aborted, nothing changed."; exit 0 ;;
    esac
fi

# ------------------------------------------------------------
# Backup branch, so this is always trivially reversible
# ------------------------------------------------------------
if git rev-parse HEAD >/dev/null 2>&1; then
    BACKUP_BRANCH="pre-course-upgrade-$(date +%Y%m%d-%H%M%S)-$RANDOM"
    if git branch "$BACKUP_BRANCH" 2>/dev/null; then
        echo "Created backup branch: $BACKUP_BRANCH"
        echo "(if anything looks wrong later: git reset --hard $BACKUP_BRANCH)"
    else
        echo "Note: could not create a backup branch (non-fatal, continuing)."
    fi
else
    echo "No commits yet on this repo - skipping backup branch."
fi

echo
echo "--- Removing committed binaries and stray files ---"
git rm -f --cached --ignore-unmatch 01_HelloWorld 02_Variables >/dev/null 2>&1 || true
rm -f 01_HelloWorld 02_Variables
git rm -f --cached --ignore-unmatch Matfinance plan-advancedHelloWorld.prompt.md main.cpp >/dev/null 2>&1 || true
rm -f Matfinance plan-advancedHelloWorld.prompt.md main.cpp
echo "  done"

echo
echo "--- Writing lesson files ---"
